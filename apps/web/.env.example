# Explicit runtime environment: development | test | preview | production.
# This is deliberately independent of NODE_ENV.
APP_ENV=development

# Development default. `auto` uses PostgreSQL and falls back to mock fixtures when
# the local database cannot be reached. Preview and production default to `postgres`.
CATALOG_DATA_SOURCE=auto
DATABASE_URL=postgresql://aad:aad-local-only@localhost:5432/aad_habitat

# Mock data in a deployed preview requires both APP_ENV=preview and this explicit
# acknowledgement. APP_ENV=production always rejects mock data.
ALLOW_MOCK_CATALOG_IN_PREVIEW=false

# Customer preview gate. `shared-password` is accepted only with APP_ENV=preview.
PREVIEW_ACCESS_MODE=off
# Generate with: npm run preview:hash-password
PREVIEW_ACCESS_PASSWORD_HASH=
# At least 32 characters. Render generates this value automatically.
PREVIEW_ACCESS_SESSION_SECRET=
# Optional; defaults to seven days and is capped at 30 days.
PREVIEW_ACCESS_SESSION_DURATION_SECONDS=604800

# Canonical URL for production metadata and sitemap generation.
APP_BASE_URL=http://localhost:3000
