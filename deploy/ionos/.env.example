# Non-secret deployment coordinates. Copy to .env and adjust before running Compose.
ACME_EMAIL=operations@example.org
PREVIEW_DOMAIN=preview.example.org
PRODUCTION_DOMAIN=database.example.org

# Use an immutable release tag or digest in production. `local` builds from this checkout.
AAD_APP_IMAGE=aad-habitat-web
AAD_APP_TAG=local
