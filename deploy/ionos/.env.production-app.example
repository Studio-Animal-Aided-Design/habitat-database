APP_ENV=production
CATALOG_DATA_SOURCE=postgres
ALLOW_MOCK_CATALOG_IN_PREVIEW=false
DATABASE_URL=postgresql://aad_production:CHANGE_ME_PRODUCTION_DB_PASSWORD@production-db:5432/aad_habitat_production

PREVIEW_ACCESS_MODE=off

IMPORT_API_ENABLED=true
IMPORT_API_TOKEN_HASH=CHANGE_ME_SCRYPT_HASH
IMPORT_STAGING_ROOT=/var/lib/aad/import-staging
IMPORT_MAX_UPLOAD_BYTES=26214400
IMPORT_MAX_FILES=128
IMPORT_RUN_TTL_SECONDS=86400
