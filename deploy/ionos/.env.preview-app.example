APP_ENV=preview
CATALOG_DATA_SOURCE=postgres
ALLOW_MOCK_CATALOG_IN_PREVIEW=false
DATABASE_URL=postgresql://aad_preview:CHANGE_ME_PREVIEW_DB_PASSWORD@preview-db:5432/aad_habitat_preview

PREVIEW_ACCESS_MODE=shared-password
PREVIEW_ACCESS_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH
PREVIEW_ACCESS_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
PREVIEW_ACCESS_SESSION_DURATION_SECONDS=604800
